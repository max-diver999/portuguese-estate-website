---
import globalStyles from '../styles/global.css?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import WhatsAppIntentTracker from '../components/WhatsAppIntentTracker.astro';
import CurrencyEngine from '../components/CurrencyEngine.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schemas?: object[];
  preloadImage?: string;
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
}

const {
  title,
  description = SITE.description,
  canonical = Astro.url.href,
  ogImage = `${SITE.url}/og-default.png?v=2`,
  type = 'website',
  noindex = false,
  schemas = [],
  preloadImage,
  preloadImageSrcset,
  preloadImageSizes,
} = Astro.props;

const TITLE_MAX = 60;
const withBrand = `${title} | Portuguese Estate`;
const fullTitle = title.includes('Portuguese Estate')
  ? title
  : withBrand.length <= TITLE_MAX
    ? withBrand
    : title;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  email: SITE.email,
  logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon.svg` },
  contactPoint: {
    '@type': 'ContactPoint',
    email: SITE.email,
    contactType: 'customer service',
    availableLanguage: ['English', 'Portuguese'],
  },
  sameAs: [
    SITE.url,
    ...SITE.sameAs,
    ...(SITE.wikidataId ? [`https://www.wikidata.org/wiki/${SITE.wikidataId}`] : []),
  ],
};

const allSchemas = [orgSchema, ...schemas];
---
<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#1c2740" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex
    ? <meta name="robots" content="noindex,nofollow" />
    : <meta name="robots" content="index,follow,max-image-preview:large" />}
  {!noindex && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content={fullTitle} />
  <meta name="twitter:image" content={ogImage} />
  <meta property="og:site_name" content={SITE.name} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png?v=3" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-16.png?v=3" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />

  <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
  <link rel="dns-prefetch" href="https://res.cloudinary.com" />

  {preloadImage && (
    <link
      rel="preload"
      as="image"
      href={preloadImage}
      fetchpriority="high"
      {...(preloadImageSrcset ? { imagesrcset: preloadImageSrcset, imagesizes: preloadImageSizes } : {})}
    />
  )}

  <style is:inline>
    :root {
      --color-page: #ede6da;
      --color-surface: #f6f1e8;
      --color-ink: #1c2740;
      --color-muted: #4b5361;
      --color-deep: #1c2740;
      --color-border: #cfc5b3;
      --font-sans: 'Archivo', system-ui, sans-serif;
    }
    html { -webkit-font-smoothing: antialiased; }
    body {
      margin: 0;
      background: var(--color-page);
      color: var(--color-muted);
      font-family: var(--font-sans);
      line-height: 1.65;
      font-size: 1rem;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
    }
    body > main { flex: 1 0 auto; }
    h1, h2, h3 {
      font-family: var(--font-sans);
      color: var(--color-ink);
      line-height: 1.25;
      font-weight: 600;
    }
    .home-hero__frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      min-height: 280px;
    }
    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--color-deep);
      color: #f6f1e8;
      font-weight: 700;
      text-decoration: none;
    }
  </style>
  <link rel="stylesheet" href={globalStyles} />

  {allSchemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <WhatsAppFloat />
  <CurrencyEngine />
  <WhatsAppIntentTracker />
  <GoogleAnalytics />
</body>
</html>
