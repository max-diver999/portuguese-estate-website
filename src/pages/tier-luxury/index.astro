---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import CommercialBudgetLadder from '../../components/CommercialBudgetLadder.astro';

const faqItems = [
  {
    question: 'What counts as luxury property in Portugal?',
    answer: 'There is no legal threshold. In practice it means Cascais and Estoril seafront, Comporta and the Alentejo coast, Chiado and Príncipe Real in Lisbon, and the Quinta do Lago and Vale do Lobo triangle in the Algarve — typically €1M+ with scarcity value rather than yield.',
  },
  {
    question: 'How does AIMI affect high-value purchases?',
    answer: 'AIMI is charged on the taxable value (VPT) of Portuguese residential property held by each individual: 0.7% on the band from €600,000 to €1M, and 1% above €1M in VPT. Joint ownership splits the allowance, so how you title the property materially changes the annual bill.',
  },
  {
    question: 'Do luxury buyers need different due diligence?',
    answer: 'Yes. Expect coastal and heritage restrictions, condominium charges on serviced schemes, higher AIMI tiers, and inheritance exposure that ordinary buyers never meet. Verify the VPT certificate and the last two IMI receipts before CPCV, not at escritura.',
  },
  {
    question: 'What rental strategy works for prime Portuguese assets?',
    answer: 'Prime owners often underlet deliberately to protect the asset and avoid wear. Gross yields of 2.5–4.5% are normal at this level, and Lisbon RMAL containment zones restrict new short-term licences outright. Treat any short-let projection as unverified until the RNAL position is confirmed.',
  },
  {
    question: 'How do you source prime and off-market stock?',
    answer: 'Through vetted Portuguese agencies and developer relationships in Cascais, Comporta, Lisbon and the central Algarve. Send budget and property type; referral relationships are disclosed on our methodology page and we take no buyer-side commission.',
  },
];
---
<BaseLayout
  title="Luxury Portugal Property €500k+: 2026 Shortlist"
  description="Prime Portugal property for foreign HNW buyers — Cascais, Comporta, Chiado, Quinta do Lago. Independent shortlist with AIMI, IMT and due diligence routing."
>
  <section class="site-container py-12 md:py-16 max-w-3xl">
    <CommercialBudgetLadder current="luxury" />
    <header class="mb-8">
      <span class="badge-pill mb-4">Luxury tier</span>
      <h1 class="mb-4">Luxury Portugal property investment</h1>
      <p class="text-lg text-[var(--color-muted)]">
        At this level you compete on scarcity, not yield — and the tax planning matters more than the price.
      </p>
    </header>

    <div class="prose mb-10 text-[var(--color-muted)]">
      <p><strong>Quick answer:</strong> Above €500,000 the Portuguese market narrows to Cascais, Comporta, central Lisbon and the Algarve golden triangle. The Algarve alone took 42.4% of non-resident deal value in 2025 (INE). Expect about 10% cash-to-close, gross yields of 2.5–4.5%, and an AIMI bill of 0.7% on VPT between €600k and €1M, rising to 1% above that.</p>
      <table class="w-full text-sm mb-6">
        <thead>
          <tr><th>Market</th><th>Entry level</th><th>Buyer profile</th></tr>
        </thead>
        <tbody>
          <tr><td>Cascais / Estoril</td><td>€900k+</td><td>Family relocation, strong liquidity</td></tr>
          <tr><td>Comporta / Alentejo coast</td><td>€1.5M+</td><td>Lifestyle, thinner resale pool</td></tr>
          <tr><td>Chiado / Príncipe Real</td><td>€800k+</td><td>Prime urban, RMAL containment</td></tr>
          <tr><td>Quinta do Lago / Vale do Lobo</td><td>€1.2M+</td><td>Seasonal luxury, golf-led</td></tr>
        </tbody>
      </table>
      <p>Research: <a href="/areas/cascais-property-investment/">Cascais</a> · <a href="/areas/comporta-property-investment/">Comporta</a> · <a href="/areas/chiado-principe-real-property/">Chiado &amp; Príncipe Real</a> · <a href="/guides/aimi-wealth-tax-portugal-property/">AIMI wealth tax</a> · <a href="/guides/portugal-property-1-million-plus-investment/">€1M+ guide</a></p>
    </div>

    <LeadForm
      title="Request prime Portugal shortlist"
      subtitle="Cascais · Comporta · Lisbon prime · Algarve triangle"
      context="Tier luxury Portugal property landing"
    />
    <FaqBlock items={faqItems} />
    <p class="text-xs text-[var(--color-muted)] mt-6">Not financial or legal advice. <a href="/privacy-policy/">Privacy Policy</a></p>
  </section>
</BaseLayout>
