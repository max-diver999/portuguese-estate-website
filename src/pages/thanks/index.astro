---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
---
<BaseLayout
  title="Thank You"
  description="Thank you for contacting Portuguese Estate."
  noindex={true}
>
  <section class="site-container py-20 max-w-xl text-center">
    <p class="text-4xl mb-4">✓</p>
    <h1 class="mb-4" id="thanks-heading">Thank you</h1>
    <p class="text-[var(--color-muted)] mb-8" id="thanks-body">Thanks for visiting {SITE.name}.</p>
    <a href="/guides/" class="btn-primary px-6 py-3">Browse guides</a>
  </section>
  {/* This page is prerendered, so lead=1 must be read in the browser, not at build time. */}
  {/* This was is:inline and ran at parse time, three seconds before
      GoogleAnalytics.astro defines `peTrack` or `gtag`, so the event it built
      correctly was thrown away. `track` queues until one of them exists. The
      de-duplication against the form's own send is unchanged. */}
  <script>
    import { track } from '../../lib/track';

    if (new URLSearchParams(window.location.search).get('lead') === '1') {
      const heading = document.getElementById('thanks-heading');
      const body = document.getElementById('thanks-body');
      if (heading) heading.textContent = 'Request received';
      if (body) {
        body.textContent =
          'We received your shortlist request. Expect a reply by email or WhatsApp within one business day.';
      }

      const params = { lead_type: 'shortlist_form', page_path: window.location.pathname };
      track('page_view_thanks', params);

      let alreadySent = false;
      try {
        const stamp = Number(sessionStorage.getItem('pe_lead_event_sent') || 0);
        alreadySent = stamp > 0 && Date.now() - stamp < 120000;
        sessionStorage.removeItem('pe_lead_event_sent');
      } catch {
        /* private mode: report once */
      }
      if (!alreadySent) {
        track('generate_lead', { ...params, value: 1, currency: 'EUR' });
      }
    }
  </script>
</BaseLayout>
