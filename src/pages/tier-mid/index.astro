---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import CommercialBudgetLadder from '../../components/CommercialBudgetLadder.astro';

const faqItems = [
  {
    question: 'What can I buy in Portugal for around €300,000?',
    answer: 'At €300k you can target a Porto centre T2, a Lisbon fringe apartment in Marvila or Alcântara, a two-bedroom Algarve unit away from the prime golf resorts, or an edge-of-Cascais flat. Comporta and Chiado stay out of reach at this level.',
  },
  {
    question: 'Is €200k–€500k the main foreign buyer band?',
    answer: 'Yes. INE data puts the average non-EU purchase near €470,000 and the UK buyer average around €513,000, so this tier covers the bulk of foreign transactions. It is also the band with the deepest resale liquidity when you exit.',
  },
  {
    question: 'What closing costs apply at this tier?',
    answer: 'Around 11% above price. Non-residents completing from 1 September 2026 pay flat 7.5% IMT under DL 97/2026 with no progressive bands and no standard exemptions, plus 0.8% stamp duty and roughly 2–3% legal, notary and registry. On €350,000 that is close to €38,000.',
  },
  {
    question: 'What mortgage options exist for non-residents at €300k?',
    answer: 'Portuguese banks lend selectively to non-residents, typically at lower loan-to-value than for residents, with longer approval timelines and a mandatory life policy. Start the application early — bank valuation often lags the developer price list on new build.',
  },
  {
    question: 'Which region offers the best mid-tier yield?',
    answer: 'Porto centre and Lisbon fringe generally beat prime Algarve on gross yield at this budget, because year-round tenant demand carries the whole calendar. Algarve competes on seasonal short-let revenue, but only where the RNAL position is verified before deposit.',
  },
];
---
<BaseLayout
  title="Portugal Property €200k–€500k: 2026 Shortlist"
  description="Portugal property between €200,000 and €500,000 — Porto centre, Lisbon fringe, Algarve, Cascais edge. Independent shortlist with yield, IMT and tax notes."
>
  <section class="site-container py-12 md:py-16 max-w-3xl">
    <CommercialBudgetLadder current="mid" />
    <header class="mb-8">
      <span class="badge-pill mb-4">Mid tier</span>
      <h1 class="mb-4">Buy property in Portugal for €200k–€500k</h1>
      <p class="text-lg text-[var(--color-muted)]">
        The core foreign-buyer band — where liquidity, yield and lifestyle actually overlap.
      </p>
    </header>

    <div class="prose mb-10 text-[var(--color-muted)]">
      <p><strong>Quick answer:</strong> €200k–€500k is the deepest band in the Portuguese market for foreign buyers, with the average non-EU purchase near €470,000 (INE). It buys a Porto centre T2, a Lisbon fringe apartment, an Algarve two-bed away from prime golf, or a Cascais edge flat. Expect about 11% cash-to-close and 4.3–5.5% gross yield.</p>
      <table class="w-full text-sm mb-6">
        <thead>
          <tr><th>Region</th><th>Typical unit</th><th>Gross yield</th></tr>
        </thead>
        <tbody>
          <tr><td>Porto centre</td><td>T2 resale</td><td>4.8–5.5%</td></tr>
          <tr><td>Lisbon fringe</td><td>T2 Marvila / Alcântara</td><td>4.3–5%</td></tr>
          <tr><td>Algarve non-prime</td><td>2-bed apartment</td><td>4.5–5.5%</td></tr>
          <tr><td>Cascais edge</td><td>T1–T2</td><td>3.8–4.5%</td></tr>
        </tbody>
      </table>
      <p>Guides: <a href="/guides/portugal-property-under-500000-euros/">Under €500,000</a> · <a href="/guides/cost-of-buying-property-portugal/">Cost of buying</a> · <a href="/guides/non-resident-mortgage-portugal/">Non-resident mortgage</a> · <a href="/compare/porto-vs-lisbon-property-investment/">Porto vs Lisbon</a> · <a href="/tier-luxury/">Luxury tier €500k+</a></p>
    </div>

    <LeadForm
      title="Get your €200k–€500k shortlist"
      subtitle="Porto · Lisbon fringe · Algarve · Cascais"
      context="Tier mid Portugal property landing"
    />
    <FaqBlock items={faqItems} />
    <p class="text-xs text-[var(--color-muted)] mt-6">Not financial or legal advice. <a href="/privacy-policy/">Privacy Policy</a></p>
  </section>
</BaseLayout>
