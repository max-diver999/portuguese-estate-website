---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import CommercialBudgetLadder from '../../components/CommercialBudgetLadder.astro';

const faqItems = [
  {
    question: 'Can I buy property in Portugal under €200,000?',
    answer: 'Yes, but not in Lisbon or Cascais prime. Under €200k works in Braga and the wider Norte, the Silver Coast towns north of Lisbon, eastern Algarve around Tavira, and outer Porto parishes. Expect a resale apartment or a small townhouse rather than new-build coastal stock.',
  },
  {
    question: 'What is the total cash-to-close at this budget?',
    answer: 'Budget roughly 10–11% above the purchase price. Non-residents completing from 1 September 2026 pay flat 7.5% IMT under DL 97/2026, plus 0.8% stamp duty, plus about 2–3% for lawyer, notary and registry. On a €180,000 purchase that is around €19,000 on top.',
  },
  {
    question: 'Which regions give the best yield under €200k?',
    answer: 'Braga and the Silver Coast typically show 5–7% gross, ahead of eastern Algarve at 4.5–6%. Lower price per square metre tends to lift gross yield where a real tenant pool exists — university cities and year-round towns beat purely seasonal coast at this budget.',
  },
  {
    question: 'Is resale or off-plan better at entry level?',
    answer: 'Resale usually wins for a first foreign purchase in this band. Off-plan ties capital to construction milestones and requires a Decreto-Lei 67/2003 bank guarantee on every pre-deed payment. Resale lets you inspect the actual unit and verify the caderneta predial before deposit.',
  },
  {
    question: 'How fast will you send entry-tier options?',
    answer: 'Within one business day we return 3–5 matches in your band with links to the relevant area guides and a cost breakdown. Viewings are scheduled through a licensed Portuguese partner; referral relationships are disclosed on our methodology page.',
  },
];
---
<BaseLayout
  title="Portugal Property Under €200,000: 2026 Shortlist"
  description="Portugal property under €200k for foreign buyers — Braga, Silver Coast, eastern Algarve, outer Porto. Independent shortlist with IMT and closing cost notes."
>
  <section class="site-container py-12 md:py-16 max-w-3xl">
    <CommercialBudgetLadder current="entry" />
    <header class="mb-8">
      <span class="badge-pill mb-4">Entry tier</span>
      <h1 class="mb-4">Buy property in Portugal under €200,000</h1>
      <p class="text-lg text-[var(--color-muted)]">
        Secondary-market value bands with a real tenant pool — with honest capex and tax notes, not portal spam.
      </p>
    </header>

    <div class="prose mb-10 text-[var(--color-muted)]">
      <p><strong>Quick answer:</strong> Under €200,000 buys in Braga, the Silver Coast, eastern Algarve and outer Porto — not Lisbon or Cascais prime. Cash-to-close runs about 10–11% above price once flat 7.5% IMT, 0.8% stamp duty and legal fees are counted. Gross yields of 5–7% are realistic in Braga and the Silver Coast, 4.5–6% in the eastern Algarve.</p>
      <table class="w-full text-sm mb-6">
        <thead>
          <tr><th>Typical fit</th><th>Price band</th><th>Gross yield</th></tr>
        </thead>
        <tbody>
          <tr><td>Braga T2 resale</td><td>€130k–190k</td><td>5–7%</td></tr>
          <tr><td>Silver Coast townhouse</td><td>€150k–200k</td><td>5–6.5%</td></tr>
          <tr><td>Eastern Algarve T1–T2</td><td>€160k–200k</td><td>4.5–6%</td></tr>
          <tr><td>Outer Porto parish</td><td>€140k–195k</td><td>5–6%</td></tr>
        </tbody>
      </table>
      <p>Related: <a href="/guides/portugal-property-under-300000-euros/">Under €300,000</a> · <a href="/guides/best-portugal-property-under-4000-euro-m2/">Under €4,000/m²</a> · <a href="/guides/hidden-costs-buying-property-portugal/">Hidden costs</a> · <a href="/tier-mid/">€200k–€500k tier</a></p>
    </div>

    <LeadForm
      title="Get sub-€200k shortlist"
      subtitle="Region · renovation tolerance · rental goal"
      context="Tier entry Portugal property landing"
    />
    <FaqBlock items={faqItems} />
    <p class="text-xs text-[var(--color-muted)] mt-6">Not financial or legal advice. <a href="/privacy-policy/">Privacy Policy</a></p>
  </section>
</BaseLayout>
