---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { hubSchemas } from '../../lib/hubSchema';
import InlineCta from '../../components/InlineCta.astro';
import ContentCard from '../../components/ContentCard.astro';

const developers = (await getCollection('developers'))
  .filter((d) => !d.data.noindex)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

function badgeFor(id: string) {
  return id.includes('farinvest') ? 'Agency' : 'Developer';
}
const schemas = hubSchemas({
  path: '/developers/',
  name: 'Developer profiles',
  description: 'Independent Portugal developer and agency due diligence profiles for off-plan buyers.',
  itemCount: developers.length,
});

---
<BaseLayout
  schemas={schemas}
  title="Portugal Property Developers — Due Diligence Profiles"
  description="Independent Portugal developer and agency due diligence profiles — Vanguard, VIC, Farinvest brokerage, track record, CPCV checks, and off-plan buyer checklists."
>
  <section class="site-container py-14 md:py-20">
    <header class="max-w-2xl mb-12">
      <h1 class="text-3xl">Developer &amp; agency profiles</h1>
      <p class="text-lg text-[var(--color-muted)] mt-3">
        Entity authority reviews — not sales brochures. Verify permits, delivery history, bank guarantees, and escrow before any deposit. Start with the <a href="/guides/portugal-property-developers-guide-2026/" class="text-[var(--color-accent)]">developers hub</a>.
      </p>
    </header>

    <div class="prose max-w-2xl mb-12 text-[var(--color-muted)]">
      <h2 class="text-xl text-[var(--color-ink)]">What a developer profile covers</h2>
      <p>
        Each profile checks the legal entity behind a scheme rather than the marketing brand.
        AICCOPN recorded 41,592 new dwelling licences in 2025, up 20.1% year on year, so the
        number of active promoters is rising faster than the track record available to verify
        them. A brand name on a hoarding is frequently not the entity named on the CPCV.
      </p>
      <ul>
        <li><strong>Legal identity</strong> — company name and NIPC on the land registry versus the marketing brand</li>
        <li><strong>Delivery history</strong> — completed schemes, handover dates, and slippage against the original longstop</li>
        <li><strong>Guarantees</strong> — Decreto-Lei 67/2003 bank guarantee or insurance covering every pre-deed payment</li>
        <li><strong>Licensing</strong> — licença de construção, IMPIC promotional filing, and the utilisation licence position</li>
        <li><strong>Buyer terms</strong> — payment milestones tied to construction certificates, not calendar dates alone</li>
      </ul>

      <h2 class="text-xl text-[var(--color-ink)]">Before you transfer a deposit</h2>
      <p>
        Match the guarantee certificate amount and beneficiary to the exact seller entity on the
        contract, not the brand alone. Non-residents completing from 1 September 2026 pay flat
        7.5% IMT under DL 97/2026, so escritura timing changes the total cash-to-close on any
        off-plan purchase that straddles that date. Read the
        <a href="/guides/cpcv-promissory-contract-portugal/" class="text-[var(--color-accent)]">CPCV guide</a> and the
        <a href="/guides/off-plan-property-portugal-guide/" class="text-[var(--color-accent)]">off-plan guide</a>
        before signing, and keep an independent lawyer — never the developer's.
      </p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {developers.map((dev) => (
        <ContentCard
          href={`/developers/${dev.id}/`}
          title={dev.data.title}
          description={dev.data.description}
          image={dev.data.heroImage}
          badges={[badgeFor(dev.id)]}
          meta={`${dev.data.readingTime ?? 8} min read`}
          placeholder="🏗️"
        />
      ))}
    </div>

    <InlineCta
      headline='Checking a developer before a deposit?'
      subtext='Send the project and seller name — we return registry, licence and guarantee checks to run.'
      buttonHref="/get-shortlist/"
      ctaId='developers_hub_inline'
      whatsappMessage="Hi Portuguese Estate! I'd like due diligence on a Portuguese developer before I pay a deposit."
    />
  </section>
</BaseLayout>
