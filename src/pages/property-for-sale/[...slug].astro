---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { SITE } from '../../data/site';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('property-for-sale');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const hasInlineFaqBlock = entry.body?.includes('<FaqBlock') ?? false;

const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  readingTime,
  heroImage,
  heroImageAlt,
  heroImageCredit,
  heroImageLicence,
  heroImageSource,
  faq,
  noindex,
} = entry.data;
---
<ArticleLayout
  relatedSlugs={entry.data.relatedSlugs ?? []}
  articleSlug={entry.id}
  {title}
  {description}
  {pubDate}
  {updatedDate}
  {author}
  readingTime={readingTime ?? 8}
  {heroImage}
  {heroImageAlt}
  {heroImageCredit}
  {heroImageLicence}
  {heroImageSource}
  {faq}
  {noindex}
  {hasInlineFaqBlock}
  contextLabel={title}
  canonical={`${SITE.url}/property-for-sale/${entry.id}/`}
>
  <Content />
</ArticleLayout>
