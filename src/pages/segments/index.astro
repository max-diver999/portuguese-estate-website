---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { hubSchemas } from '../../lib/hubSchema';
import InlineCta from '../../components/InlineCta.astro';
import ContentCard from '../../components/ContentCard.astro';

const segments = (await getCollection('segments'))
  .filter((g) => !g.data.noindex)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const schemas = hubSchemas({
  path: '/segments/',
  name: 'Buyer segments',
  description: 'Country-specific Portugal property guidance covering tax domicile, banking and residency by nationality.',
  itemCount: segments.length,
});

---
<BaseLayout
  schemas={schemas}
  title="Buyer Guides by Nationality"
  description="Portugal property guides for Brazilian, Angolan, French, UK, and US buyers. Tax, banking, residency, and regional market data for 2026."
>
  <section class="site-container py-14 md:py-20">
    <header class="max-w-2xl mb-12">
      <h1 class="text-3xl">Buyer segments</h1>
      <p class="text-lg text-[var(--color-muted)] mt-3">
        Country-specific guidance for foreign buyers. Same ownership rights for all nationalities; practical steps differ by tax domicile and banking.
      </p>
      <p class="text-sm text-[var(--color-muted)] mt-2">{segments.length} segment guides.</p>
    </header>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {segments.map((item) => (
        <ContentCard
          href={`/segments/${item.id}/`}
          title={item.data.title}
          description={item.data.description}
          image={item.data.heroImage}
          badges={item.data.tags?.slice(0, 2) ?? []}
          meta={`${item.data.readingTime ?? 8} min read`}
        />
      ))}
    </div>

    <InlineCta
      headline='Buying from outside the EU?'
      subtext='Tell us your tax residence — we flag the banking, NIF and IMT steps that apply to you.'
      buttonHref="/get-shortlist/"
      ctaId='segments_hub_inline'
      whatsappMessage="Hi Portuguese Estate! I'd like guidance for buyers from my country."
    />
  </section>
</BaseLayout>
