---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import FaqBlock from '../../components/FaqBlock.astro';

const faqItems = [
  {
    question: 'What happens in a Portugal property consultation?',
    answer: 'You share budget, timeline, residency goal and preferred regions. We map the options against non-resident tax exposure, RNAL and short-term rental rules, and realistic yield, then route to a licensed Portuguese partner if you want viewings or off-plan terms.',
  },
  {
    question: 'Can you compare Lisbon, Porto and the Algarve in one request?',
    answer: 'Yes. Most buyers narrow to two or three regions before flying out. We use our own comparison research and INE market data so you understand the trade-offs on price per square metre, gross yield and licensing before committing to a CPCV deposit.',
  },
  {
    question: 'Do you charge for consultations?',
    answer: 'No. Shortlist and consultation requests are free. Portuguese Estate takes no buyer-side commission; partners may pay a referral fee, which is disclosed on our methodology page.',
  },
  {
    question: 'How is this different from Idealista or Imovirtual?',
    answer: 'Portals list inventory. We publish independent due diligence and filter options to your budget band and goal, then hand you the tax, legal and yield research behind each match on portuguese-estate.com.',
  },
  {
    question: 'Does buying property still give me Portuguese residency?',
    answer: 'No. Law 56/2023 closed the real estate route to the Golden Visa in October 2023. Property can support a D7 or D8 application by satisfying the accommodation requirement, but the purchase itself confers no immigration status.',
  },
];
---
<BaseLayout
  title="Portugal Property Consultation for Foreign Buyers"
  description="Independent Portugal property consultation for foreign buyers. Compare Lisbon, Porto, the Algarve and Comporta in one request — tax, yield and partner referral."
>
  <section class="site-container py-12 md:py-16 max-w-3xl">
    <header class="mb-8">
      <span class="badge-pill mb-4">Cross-region</span>
      <h1 class="mb-4">Portugal property consultation</h1>
      <p class="text-lg text-[var(--color-muted)]">
        Not sure which region fits? Tell us budget, hold period and residency goal — we route to the right market and partner.
      </p>
    </header>

    <div class="prose mb-10 text-[var(--color-muted)]">
      <p><strong>Quick answer:</strong> Portugal is not one market. Porto and Lisbon fringe skew year-round rental yield; the Algarve skews seasonal short-let and took 42.4% of non-resident deal value in 2025 (INE); Cascais and Comporta skew lifestyle and capital preservation. One consultation request lets you compare regions before committing to flights or a CPCV deposit.</p>
      <p>Browse by budget: <a href="/tier-entry/">Under €200k</a> · <a href="/tier-mid/">€200k–€500k</a> · <a href="/tier-luxury/">Luxury €500k+</a></p>
      <p>Core guides: <a href="/guides/portugal-property-investment-guide/">Portugal property investment</a> · <a href="/guides/best-regions-invest-portugal-property-2026/">Best regions 2026</a> · <a href="/guides/imt-tax-non-resident-portugal-2026/">IMT for non-residents</a> · <a href="/guides/portugal-residency-options-without-golden-visa/">Residency without Golden Visa</a></p>
      <p>Compare markets: <a href="/compare/porto-vs-lisbon-property-investment/">Porto vs Lisbon</a> · <a href="/compare/algarve-vs-lisbon-property-investment/">Algarve vs Lisbon</a> · <a href="/compare/portugal-vs-spain-property-investment/">Portugal vs Spain</a></p>
    </div>

    <LeadForm
      title="Book a Portugal property consultation"
      subtitle="Budget · regions · yield or lifestyle goal"
      context="Portugal property consultation landing"
    />
    <FaqBlock items={faqItems} />
    <p class="text-xs text-[var(--color-muted)] mt-6">Not financial or legal advice. <a href="/privacy-policy/">Privacy Policy</a></p>
  </section>
</BaseLayout>
