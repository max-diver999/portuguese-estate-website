---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { hubSchemas } from '../../lib/hubSchema';
import ContentCard from '../../components/ContentCard.astro';
import LeadForm from '../../components/LeadForm.astro';
import InlineCta from '../../components/InlineCta.astro';
import { FEATURED_GUIDE_SLUGS } from '../../data/featured';

const guides = (await getCollection('guides'))
  .filter((g) => !g.data.noindex)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const priority = FEATURED_GUIDE_SLUGS.map((slug) => guides.find((g) => g.id === slug)).filter(Boolean);

/**
 * The hub previously rendered all 63 guides as one flat card wall, which gave a
 * reader no route in and Google no topical structure (hub sat at position ~73).
 * Cluster by intent. Frontmatter tags are absent on most guides, so match on the
 * slug, which is reliable. First match wins, so order matters: the more specific
 * clusters are listed before the catch-all.
 */
const GUIDE_CLUSTERS: { name: string; blurb: string; pattern: RegExp }[] = [
  {
    name: 'Tax & purchase costs',
    blurb: 'IMT, IMI, AIMI, stamp duty and the full cash-to-close stack for non-residents.',
    pattern: /imt|imi|aimi|stamp-duty|capital-gains|inheritance|moderate-rent|hidden-costs|cost-of-buying|buying-costs|tax/,
  },
  {
    name: 'Buying process & due diligence',
    blurb: 'NIF, CPCV, escritura, power of attorney, mortgages and the checks to run before a deposit.',
    pattern: /how-to-buy|cpcv|escritura|nif|due-diligence|power-of-attorney|deposit|remotely|foreigner|scams|prenuptial|off-plan|mortgage/,
  },
  {
    name: 'Rentals, yields & licensing',
    blurb: 'Gross versus net yield, AL and RNAL licensing, containment zones and management costs.',
    pattern: /yield|rental|buy-to-let|airbnb|alojamento|rnal|al-license|long-term-vs|property-management|maintenance-costs/,
  },
  {
    name: 'Residency & visas',
    blurb: 'D7, D8 and what remains after the Golden Visa real estate route closed.',
    pattern: /golden-visa|d7-visa|digital-nomad|residency/,
  },
  {
    name: 'Markets, budgets & data',
    blurb: 'Regional guides, budget bands and INE market data for 2026.',
    pattern: /./,
  },
];

const assigned = new Set<string>();
const clusters = GUIDE_CLUSTERS.map((cluster) => {
  const items = guides.filter((guide) => {
    if (assigned.has(guide.id)) return false;
    if (!cluster.pattern.test(guide.id)) return false;
    assigned.add(guide.id);
    return true;
  });
  return { ...cluster, items };
}).filter((cluster) => cluster.items.length > 0);
const schemas = hubSchemas({
  path: '/guides/',
  name: 'Guides',
  description: 'Independent Portugal property guides for foreign buyers — IMT, yields, buying process and due diligence.',
  itemCount: guides.length,
});

---
<BaseLayout
  schemas={schemas}
  title="Portugal Property Guides 2026 — IMT, Yields, Golden Visa"
  description="63 independent guides for foreign buyers: IMT 7.5%, deposit, maintenance, step-by-step purchase, Algarve yields — updated June 2026."
>
  <section class="site-container py-14 md:py-20">
    <header class="max-w-2xl mb-12">
      <h1 class="text-3xl">Portugal property investment guides</h1>
      <p class="text-lg text-[var(--color-muted)] mt-3">
        Research-first articles for US, UK, and EU buyers — IMT, CPCV, yields, and due diligence. Not developer brochures.
      </p>
      <p class="text-sm text-[var(--color-muted)] mt-2">{guides.length} guides · INE-backed data · Independent editorial</p>
    </header>

    <div class="guide-search mb-10">
      <label for="guide-search">Find a guide</label>
      <input id="guide-search" type="search" placeholder={`Search ${guides.length} guides`} autocomplete="off" />
      <p id="guide-search-count" aria-live="polite">{guides.length} guides</p>
    </div>

    {priority.length > 0 && (
      <section class="mb-14">
        <h2 class="text-xl mb-5">Start here — highest buyer intent</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {priority.map((guide) => (
            <ContentCard
              href={`/guides/${guide.id}/`}
              title={guide.data.title}
              description={guide.data.description}
              image={guide.data.heroImage}
              imageAlt={guide.data.heroImageAlt}
              badges={['Pillar', ...(guide.data.tags?.slice(0, 1) ?? [])]}
              meta={`${guide.data.readingTime ?? 8} min read`}
            />
          ))}
        </div>
      </section>
    )}

    <InlineCta
      headline="Not sure which guide to read first?"
      subtext="Tell us your budget and region — we send a reading order plus matching property options."
      ctaId="guides_hub_inline"
      whatsappMessage="Hi Portuguese Estate! I'm browsing your guides and want help picking the right Portugal market for my budget."
    />

    <nav class="mb-12 flex flex-wrap gap-2" data-guide-nav aria-label="Guide categories">
      {clusters.map((cluster) => (
        <a
          href={`#${cluster.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`}
          class="inline-block text-sm font-medium px-4 py-2 rounded-full no-underline bg-[var(--color-surface)] border border-[var(--color-border)] text-[var(--color-teal)] hover:border-[var(--color-teal)]"
        >
          {cluster.name} ({cluster.items.length})
        </a>
      ))}
    </nav>

    {clusters.map((cluster) => (
      <section class="mb-14" data-guide-group id={cluster.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}>
        <h2 class="text-xl mb-1">{cluster.name}</h2>
        <p class="text-sm text-[var(--color-muted)] mb-5">{cluster.blurb}</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {cluster.items.map((guide) => (
            <div data-guide-card data-search={`${guide.data.title} ${guide.data.description} ${(guide.data.tags ?? []).join(' ')}`.toLowerCase()}>
              <ContentCard
                href={`/guides/${guide.id}/`}
                title={guide.data.title}
                description={guide.data.description}
                image={guide.data.heroImage}
                imageAlt={guide.data.heroImageAlt}
                badges={guide.data.tags?.slice(0, 2) ?? []}
                meta={`${guide.data.readingTime ?? 8} min read`}
              />
            </div>
          ))}
        </div>
      </section>
    ))}
    <p id="guide-search-empty" class="guide-search__empty" hidden>No guides match that search.</p>

    <div class="max-w-xl mx-auto mt-16">
      <LeadForm context="Guides hub shortlist" />
    </div>
  </section>
</BaseLayout>

<style>
  .guide-search { max-width:36rem;padding:1rem;border:1px solid var(--color-border);border-radius:14px;background:var(--color-surface); }
  .guide-search label { display:block;margin-bottom:.45rem;color:var(--color-ink);font-size:.85rem;font-weight:600; }
  .guide-search input { width:100%; }
  .guide-search p { margin:.45rem 0 0;color:var(--color-muted);font-size:.8rem; }
  [data-guide-card] { min-width:0; }
  [data-guide-card] > :global(*) { height:100%; }
  .guide-search__empty { padding:2rem 0;color:var(--color-muted);text-align:center; }
</style>
<script>
  (function(){
    var input=document.getElementById('guide-search'),count=document.getElementById('guide-search-count'),empty=document.getElementById('guide-search-empty'),nav=document.querySelector('[data-guide-nav]');
    var cards=Array.prototype.slice.call(document.querySelectorAll('[data-guide-card]')),groups=Array.prototype.slice.call(document.querySelectorAll('[data-guide-group]'));
    if(!input||!count||!empty)return;
    input.addEventListener('input',function(){var q=input.value.trim().toLowerCase(),visible=0;
      cards.forEach(function(card){var show=!q||(card.dataset.search||'').includes(q);card.hidden=!show;if(show)visible+=1;});
      groups.forEach(function(group){group.hidden=Boolean(q)&&!group.querySelector('[data-guide-card]:not([hidden])');});
      if(nav)nav.hidden=Boolean(q);count.textContent=visible+(visible===1?' guide':' guides');empty.hidden=visible!==0;
    });
  })();
</script>
