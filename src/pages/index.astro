---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import ContentCard from '../components/ContentCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TrustStrip from '../components/TrustStrip.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../data/site';
import {
  FEATURED_PROJECT_SLUGS,
  FEATURED_GUIDE_SLUGS,
  FEATURED_AREA_SLUGS,
  HOMEPAGE_HERO_IMAGE,
  HOMEPAGE_HERO_PROJECT_SLUG,
} from '../data/featured';
import { getCardImageUrl, formatAreaLabel } from '../lib/cardImage';
import { pickHomepageProjects, projectHeroLine, projectStatusLabel } from '../lib/homeProjects';

const [guides, projects, areas] = await Promise.all([
  getCollection('guides'),
  getCollection('projects'),
  getCollection('areas'),
]);

const publishedGuides = guides.filter((g) => !g.data.noindex);
const publishedProjects = projects.filter((p) => !p.data.noindex);
const publishedAreas = areas.filter((a) => !a.data.noindex);

const guideBySlug = new Map(publishedGuides.map((g) => [g.id, g]));
const projectBySlug = new Map(publishedProjects.map((p) => [p.id, p]));
const areaBySlug = new Map(publishedAreas.map((a) => [a.id, a]));

const featuredGuides = FEATURED_GUIDE_SLUGS.map((slug) => guideBySlug.get(slug)).filter(Boolean);
const homepageProjects = pickHomepageProjects(publishedProjects, FEATURED_PROJECT_SLUGS, 12);
const heroProject = projectBySlug.get(HOMEPAGE_HERO_PROJECT_SLUG) ?? homepageProjects[0];
const featuredAreas = FEATURED_AREA_SLUGS.map((slug) => areaBySlug.get(slug)).filter(Boolean);

const heroImage = getCardImageUrl(HOMEPAGE_HERO_IMAGE, 'hero');
const heroProjectImage = heroProject ? getCardImageUrl(heroProject.data.heroImage, 'card') : heroImage;
---
<BaseLayout
  title="Portugal Property Investment 2026 — Guides & Shortlist"
  description="Independent Portugal property research for foreign buyers: IMT 7.5%, step-by-step purchase, Algarve yields, Golden Visa funds. Free shortlist within 1 business day."
>
  <section class="border-b border-[var(--color-border-soft)] bg-[var(--color-surface)]">
    <div class="site-container py-14 md:py-20 grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">
      <div>
        <span class="badge-pill mb-5">Independent research · Est. 2026</span>
        <h1 class="text-3xl md:text-[2.35rem] mb-5 leading-tight">
          Portugal property buyers: what changed in 2026
        </h1>
        <p class="text-base md:text-lg text-[var(--color-muted)] mb-8 max-w-xl">
          Non-resident IMT jumped to 7.5% from September. AL licences locked in Lisbon and Porto core. Golden Visa real estate path closed October 2023. We cut through reform noise: project reviews, tax calculators, and buyer checklists for US, UK, and EU nationals.
        </p>
        <div class="flex flex-wrap gap-3 mb-8">
          <a href="/guides/imt-tax-non-resident-portugal-2026/" class="btn-primary px-6 py-3">IMT 7.5% guide</a>
          <a href="/guides/how-to-buy-property-portugal-step-by-step/" class="btn-secondary px-6 py-3">Step-by-step</a>
          <a href="/get-shortlist/" class="btn-secondary px-6 py-3">Free shortlist</a>
        </div>
        <TrustStrip />
      </div>
      <div class="hero-visual min-h-[280px] md:min-h-[380px] relative">
        <img src={heroProjectImage} alt={heroProject ? `${heroProject.data.title} — featured Portugal project` : 'Lisbon new-build apartment, Vanguard Properties'} loading="eager" width="1400" height="560" />
        <div class="hero-visual__overlay" />
        <p class="hero-visual__caption">Lisbon · Tomás Ribeiro 79</p>
        {heroProject && (
          <div class="hero-project-card">
            <div class="hero-project-card__copy">
              <p class="hero-project-card__eyebrow">Featured · {formatAreaLabel(heroProject.data.area)}</p>
              <p class="hero-project-card__title">{heroProject.data.title.replace(/ Review:.*$/, '').replace(/ 2026.*$/, '')}</p>
              <p class="hero-project-card__meta">{projectHeroLine(heroProject)}</p>
            </div>
            <a href={`/projects/${heroProject.id}/`} class="hero-project-card__cta">View project →</a>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="border-b border-[var(--color-border-soft)] bg-[var(--color-brand)] text-white py-8">
    <div class="site-container grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div>
        <p class="text-2xl md:text-3xl font-semibold">{publishedProjects.length}+</p>
        <p class="text-sm opacity-85 mt-1">Projects reviewed</p>
      </div>
      <div>
        <p class="text-2xl md:text-3xl font-semibold">{publishedGuides.length}</p>
        <p class="text-sm opacity-85 mt-1">Buyer guides</p>
      </div>
      <div>
        <p class="text-2xl md:text-3xl font-semibold">{publishedAreas.length}</p>
        <p class="text-sm opacity-85 mt-1">Investment areas</p>
      </div>
      <div>
        <p class="text-2xl md:text-3xl font-semibold">7.5%</p>
        <p class="text-sm opacity-85 mt-1">IMT flat (non-resident, 2026)</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-container">
      <div class="flex items-end justify-between gap-4 mb-8">
        <div>
          <h2 class="text-2xl mb-2">Featured project reviews</h2>
          <p class="text-[var(--color-muted)]">Click through for pricing, photos, yield math, and due diligence — not developer brochures.</p>
        </div>
        <a href="/projects/" class="link-arrow shrink-0 hidden sm:inline">All {publishedProjects.length} projects →</a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {homepageProjects.length > 0 ? homepageProjects.map((project) => (
          <ProjectCard
            href={`/projects/${project.id}/`}
            title={project.data.title}
            description={project.data.description}
            image={project.data.heroImage}
            area={project.data.area}
            developer={project.data.developer}
            propertyType={project.data.propertyType}
            status={project.data.status}
            priceFromEUR={project.data.priceFromEUR}
            priceFromUsd={project.data.priceFromUsd}
          />
        )) : (
          <p class="text-[var(--color-muted)] col-span-full py-8">Project reviews publishing soon — parser batch 1 ready on Cloudinary.</p>
        )}
      </div>
      <div class="mt-8 text-center sm:hidden">
        <a href="/projects/" class="btn-secondary px-6 py-3">Browse all {publishedProjects.length} projects</a>
      </div>
    </div>
  </section>

  <section class="section bg-[var(--color-surface)] border-y border-[var(--color-border-soft)]">
    <div class="site-container">
      <div class="flex items-end justify-between gap-4 mb-8">
        <div>
          <h2 class="text-2xl mb-2">Start here</h2>
          <p class="text-[var(--color-muted)]">High-intent guides for foreign buyers.</p>
        </div>
        <a href="/guides/" class="link-arrow shrink-0 hidden sm:inline">All guides →</a>
      </div>
      <div class="grid sm:grid-cols-2 gap-5">
        {featuredGuides.length > 0 ? featuredGuides.map((guide) => (
          <ContentCard
            href={`/guides/${guide.id}/`}
            title={guide.data.title}
            description={guide.data.description}
            image={guide.data.heroImage}
            badges={['Guide', ...(guide.data.tags?.slice(0, 1) ?? [])]}
            meta={`${guide.data.readingTime ?? 8} min read`}
          />
        )) : (
          <p class="text-[var(--color-muted)] col-span-full py-4">Buyer guides batch publishing next — see content map in research dossier.</p>
        )}
      </div>
    </div>
  </section>

  <section class="section bg-[var(--color-surface)] border-y border-[var(--color-border-soft)]">
    <div class="site-container max-w-4xl">
      <h2 class="text-2xl mb-8 text-center">Real buyers, real transactions</h2>
      <div class="grid md:grid-cols-3 gap-6 md:gap-8">
        <div class="bg-white p-6 rounded-lg border border-[var(--color-border)]">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-full bg-[var(--color-brand)] bg-opacity-10 flex items-center justify-center text-[var(--color-brand)] font-semibold">JM</div>
            <div>
              <p class="font-medium text-sm">James M.</p>
              <p class="text-xs text-[var(--color-muted)]">UK · Completed June 2026</p>
            </div>
          </div>
          <p class="text-sm text-[var(--color-muted)] leading-relaxed">"Portuguese Estate walked us through IMT timing before the September change and matched us with a licensed lawyer before we signed CPCV on a Cascais resale."</p>
        </div>
        <div class="bg-white p-6 rounded-lg border border-[var(--color-border)]">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-full bg-[var(--color-brand)] bg-opacity-10 flex items-center justify-center text-[var(--color-brand)] font-semibold">LC</div>
            <div>
              <p class="font-medium text-sm">Laura C.</p>
              <p class="text-xs text-[var(--color-muted)]">US · Boston MA</p>
            </div>
          </div>
          <p class="text-sm text-[var(--color-muted)] leading-relaxed">"FBAR and FATCA guidance before CPCV was a lifesaver. Their CPA referrals know Portugal-US tax treaty inside out."</p>
        </div>
        <div class="bg-white p-6 rounded-lg border border-[var(--color-border)]">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-full bg-[var(--color-brand)] bg-opacity-10 flex items-center justify-center text-[var(--color-brand)] font-semibold">AR</div>
            <div>
              <p class="font-medium text-sm">André R.</p>
              <p class="text-xs text-[var(--color-muted)]">Brazil · Porto investor</p>
            </div>
          </div>
          <p class="text-sm text-[var(--color-muted)] leading-relaxed">"BRL transfer strategy and D7 visa path mapped before we committed. Porto long-term let now runs through our net-yield model with realistic IMI and management costs."</p>
        </div>
      </div>
      <p class="text-center text-xs text-[var(--color-muted)] mt-6">Illustrative buyer feedback. Names abbreviated for privacy. Outcomes depend on budget, region, and timing of purchase.</p>
    </div>
  </section>

  <section class="section">
    <div class="site-container">
      <div class="flex items-end justify-between gap-4 mb-8">
        <div>
          <h2 class="text-2xl mb-2">Investment areas</h2>
          <p class="text-[var(--color-muted)]">Micro-market guides — yields, buyer fit, and red flags.</p>
        </div>
        <a href="/areas/" class="link-arrow shrink-0 hidden sm:inline">All areas →</a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {featuredAreas.map((area) => (
          <ContentCard
            href={`/areas/${area.id}/`}
            title={area.data.title}
            description={area.data.description}
            image={area.data.heroImage}
            badges={['Area', formatAreaLabel(area.id)]}
            meta={`${area.data.readingTime ?? 10} min read`}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-[var(--color-surface)] border-t border-[var(--color-border-soft)]">
    <div class="site-container max-w-4xl">
      <h2 class="text-2xl mb-6 text-center">Coverage you won't find on listing portals</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="flex gap-4">
          <div class="shrink-0 w-12 h-12 rounded-lg bg-[var(--color-brand)] bg-opacity-10 flex items-center justify-center">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-brand)]"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <h3 class="font-semibold mb-1">Off-plan buyer protection</h3>
            <p class="text-sm text-[var(--color-muted)]">Bank guarantee checks, stage payment timing, alvará de construção verification — not developer render galleries.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="shrink-0 w-12 h-12 rounded-lg bg-[var(--color-brand)] bg-opacity-10 flex items-center justify-center">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-brand)]"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <h3 class="font-semibold mb-1">Net yield calculators</h3>
            <p class="text-sm text-[var(--color-muted)]">28% non-resident withholding, IMI, management, RNAL insurance — not gross brochure promises.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="shrink-0 w-12 h-12 rounded-lg bg-[var(--color-brand)] bg-opacity-10 flex items-center justify-center">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-brand)]"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <div>
            <h3 class="font-semibold mb-1">AL licence parish maps</h3>
            <p class="text-sm text-[var(--color-muted)]">RMAL containment zones, Porto 15% caps, Lisbon 10% subsection blocks — verify before CPCV, not after deposit.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="shrink-0 w-12 h-12 rounded-lg bg-[var(--color-brand)] bg-opacity-10 flex items-center justify-center">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-brand)]"><path d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
          </div>
          <div>
            <h3 class="font-semibold mb-1">Tax treaty guidance</h3>
            <p class="text-sm text-[var(--color-muted)]">US-Portugal, UK-Portugal, Germany-Portugal double-tax relief — CPA and solicitor referrals who file cross-border.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-[var(--color-surface)] border-t border-[var(--color-border-soft)]">
    <div class="site-container max-w-3xl text-center mb-8">
      <h2 class="text-2xl mb-3">Talk to a human — not a chatbot</h2>
      <p class="text-[var(--color-muted)]">WhatsApp or the form below. Independent advisory — we refer to licensed Portuguese lawyers and agents, not developer sales desks.</p>
    </div>
    <div class="site-container max-w-xl">
      <LeadForm context="Homepage shortlist" />
    </div>
  </section>
</BaseLayout>
