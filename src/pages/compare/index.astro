---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { hubSchemas } from '../../lib/hubSchema';
import InlineCta from '../../components/InlineCta.astro';
import ContentCard from '../../components/ContentCard.astro';

const comparisons = (await getCollection('compare'))
  .filter((c) => !c.data.noindex)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const schemas = hubSchemas({
  path: '/compare/',
  name: 'Market comparisons',
  description: 'Side-by-side breakdowns of Portugal against other markets, plus intra-Portugal regional comparisons.',
  itemCount: comparisons.length,
});

---
<BaseLayout
  schemas={schemas}
  title="Portugal Property Market Comparisons 2026"
  description="Side-by-side breakdowns of Portugal against Spain, Greece, Italy, Dubai and the UK, plus Lisbon vs Porto and Algarve vs Lisbon — fees, yields and buyer fit."
>
  <section class="site-container py-14 md:py-20">
    <header class="max-w-2xl mb-12">
      <h1 class="text-3xl">Market comparisons</h1>
      <p class="text-lg text-[var(--color-muted)] mt-3">
        When two markets look similar on a brochure, these breakdowns show fees, yields, and buyer fit.
      </p>
    </header>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {comparisons.map((item) => (
        <ContentCard
          href={`/compare/${item.id}/`}
          title={item.data.title}
          description={item.data.description}
          image={item.data.heroImage}
          imageAlt={item.data.heroImageAlt}
          badges={['Comparison', ...(item.data.tags?.slice(0, 1) ?? [])]}
          meta={`${item.data.readingTime ?? 8} min read`}
        />
      ))}
    </div>

    <InlineCta
      headline='Still deciding between two markets?'
      subtext='Send your shortlist of regions — we return a like-for-like cost and yield comparison.'
      buttonHref="/get-shortlist/"
      ctaId='compare_hub_inline'
      whatsappMessage="Hi Portuguese Estate! I'm comparing two property markets and want an independent view."
    />
  </section>
</BaseLayout>
