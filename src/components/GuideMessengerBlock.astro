---
/**
 * WhatsApp at the start of a guide (25.09.2026, after more-group-website #89 and
 * moregroupestate-ru #108).
 *
 * On guides the first WhatsApp button sat at 45-80% of the page, below most readers'
 * stopping point. This block renders after the guide text and its inline script moves it
 * into the first 10% of the article: before the second H2 when the first section ends at
 * 4-12% of the text, otherwise after the paragraph at 8%. A guide that already has a
 * WhatsApp link in that stretch keeps its own and drops this block.
 */
import { SITE } from '../data/site';

interface Props {
  title: string;
}

const { title } = Astro.props;
const topic = title.replace(new RegExp(`\\s*[|:]\\s*${SITE.name}\\s*$`, 'i'), '').trim();
const message = topic
  ? `Hi ${SITE.name}! I'm reading your guide "${topic}" and have a question.`
  : `Hi ${SITE.name}! I'm reading your guide and have a question.`;
const waHref = `${SITE.whatsapp}?text=${encodeURIComponent(message)}`;
---
<aside class="guide-talk not-prose" data-guide-talk aria-label="Ask us on WhatsApp">
  <p class="guide-talk__title">Questions about this guide?</p>
  <p class="guide-talk__text">
    Ask us on WhatsApp. The guide's title is already in the message, so you only need to write your question.
  </p>
  <a
    href={waHref}
    target="_blank"
    rel="noopener"
    class="guide-talk__btn"
    data-cta="guide_inline_whatsapp"
    data-wa-placement="guide_inline"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    Ask on WhatsApp
  </a>
</aside>

<script is:inline>
  /*
   * Runs while the page is parsed, right after the guide text, so the block is in place
   * before the first paint.
   */
  (function placeGuideTalk() {
    var block = document.querySelector('[data-guide-talk]');
    var prose = block && block.parentElement;
    if (!prose) return;
    var kids = Array.prototype.slice.call(prose.children).filter(function (el) {
      return el !== block && el.tagName !== 'SCRIPT' && el.tagName !== 'STYLE';
    });
    var total = kids.reduce(function (n, el) { return n + el.textContent.length; }, 0);
    if (!total || kids.length < 4) return;
    var acc = 0;
    var anchor = null;
    for (var i = 0; i < kids.length; i++) {
      var el = kids[i];
      // The first section ends at 4-12% of the text: stand before the next H2.
      if (i > 0 && el.tagName === 'H2' && acc / total >= 0.04 && acc / total <= 0.12) { anchor = el; break; }
      // A WhatsApp link already this early: the guide keeps its own, this block goes.
      if (el.querySelector && el.querySelector('a[href*="wa.me"]')) { block.remove(); return; }
      acc += el.textContent.length;
      // Otherwise after the paragraph at 8% of the text, not after a lead-in to a list
      // ("these:"), and before the next element so a heading keeps its text.
      if (acc / total >= 0.08 && el.tagName === 'P' && !/[:：]\s*$/.test(el.textContent) && i + 1 < kids.length) {
        anchor = kids[i + 1];
        break;
      }
    }
    if (!anchor) return;
    // Another call to action right here (the guide's own form block): stand after it and
    // the paragraph that follows, so two boxes never sit back to back. One with a WhatsApp
    // link means the guide already offers it this early, so this block goes.
    var isCta = function (node) {
      return !!node && !/^(P|H[1-6]|UL|OL|TABLE|BLOCKQUOTE|HR|FIGURE|IMG|PRE)$/.test(node.tagName) &&
        !!node.querySelector('form, input, button, a[data-cta], a[data-wa-placement]');
    };
    var idx = kids.indexOf(anchor);
    if (isCta(kids[idx]) || isCta(kids[idx - 1])) {
      var from = isCta(kids[idx]) ? idx : idx - 1;
      if (kids[from].querySelector('a[href*="wa.me"]')) { block.remove(); return; }
      var j = from + 1;
      while (j < kids.length && kids[j].tagName !== 'P') j++;
      if (j + 1 >= kids.length) return;
      anchor = kids[j + 1];
    }
    var separator = anchor.previousElementSibling;
    prose.insertBefore(block, separator && separator.tagName === 'HR' ? separator : anchor);
  })();
</script>

<style>
  .guide-talk {
    margin: 2rem 0;
    padding: 1.1rem 1.2rem 1.2rem;
    border: 1px solid #e3e0da;
    border-left: 3px solid #15803d;
    border-radius: 0.625rem;
    background: #fff;
  }
  .guide-talk .guide-talk__title {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
    color: #161513;
  }
  .guide-talk .guide-talk__text {
    margin: 0 0 0.9rem;
    font-size: 0.92rem;
    line-height: 1.45;
    color: #4b5563;
  }
  .guide-talk .guide-talk__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.6rem 1.1rem;
    border-radius: 0.5rem;
    background: #15803d;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }
  .guide-talk .guide-talk__btn:hover,
  .guide-talk .guide-talk__btn:focus-visible {
    color: #fff;
    background: #116932;
  }
  @media (max-width: 480px) {
    .guide-talk .guide-talk__btn { display: flex; width: 100%; }
  }
</style>
