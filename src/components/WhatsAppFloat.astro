---
import { waHref as buildWaHref, hasWhatsApp, waLinkAttrs } from '../lib/contact';

interface Props {
  message?: string;
}

const { message } = Astro.props;
const path = Astro.url.pathname;

function buildDefaultMessage(pathname: string): string {
  if (pathname.startsWith('/compare/')) {
    const slug = pathname.replace(/^\/compare\/|\/$/g, '').replace(/-/g, ' ');
    return `Hi Portuguese Estate! I read your ${slug} comparison and want help choosing the right market for my budget.`;
  }
  if (pathname.startsWith('/guides/')) {
    const slug = pathname.replace(/^\/guides\/|\/$/g, '').replace(/-/g, ' ');
    return `Hi Portuguese Estate! I read your guide about ${slug} and want a property shortlist. Budget ~€___`;
  }
  if (pathname.startsWith('/areas/')) {
    return "Hi Portuguese Estate! I'm researching Portugal areas and want a shortlist in my preferred region. Budget ~€___";
  }
  if (pathname.startsWith('/get-shortlist')) {
    return "Hi Portuguese Estate! I'd like a free Portugal property shortlist. Budget ~€___";
  }
  return "Hi Portuguese Estate! I'm interested in buying property in Portugal. Please send me a free shortlist.";
}

const waMessage = message || buildDefaultMessage(path);
const waHref = buildWaHref(waMessage);
---
<a
  id="pe-wa-float"
  href={waHref}
  {...waLinkAttrs}
  class:list={['pe-wa-float', !hasWhatsApp && 'pe-wa-float--lead']}
  aria-label={hasWhatsApp ? 'Chat on WhatsApp with Portuguese Estate' : 'Request a free Portugal property shortlist'}
  data-cta="whatsapp_float"
  data-wa-placement="float"
>
  {hasWhatsApp ? (
    <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>
  ) : (
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
    </svg>
  )}
  <span class="pe-wa-float__label">{hasWhatsApp ? 'WhatsApp' : 'Free shortlist'}</span>
</a>

<style>
  /*
   * Hidden over the first screen. A fixed CTA in the corner sat on top of the
   * hero's figures rail — on the homepage it covered the IMT rate, the one number
   * the site is built around. The header already carries a WhatsApp link, so
   * nothing is lost above the fold.
   */
  .pe-wa-float {
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.5rem);
  }
  .pe-wa-float.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .pe-wa-float { transition: none; }
  }

  .pe-wa-float {
    position: fixed;
    /* Right, not left: body copy is left-aligned, so a left-hand float sat on
       top of headings and figures. */
    right: 1.25rem;
    bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
    z-index: 9998;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    /*
     * WhatsApp's dark brand green, not #25D366. The label is real visible text and
     * white on #25D366 is 1.9:1; on this it is 7.7:1 and still unmistakably WhatsApp.
     */
    background: #075E54;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.75rem 1rem;
    border-radius: 0;
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(37, 211, 102, 0.45);
    transition: transform .2s ease, box-shadow .2s ease, opacity .2s ease, visibility .2s;
  }
  .pe-wa-float--lead {
    background: var(--color-deep);
    box-shadow: 0 4px 20px rgba(45, 106, 79, 0.45);
  }
  .pe-wa-float--lead:hover {
    box-shadow: 0 6px 28px rgba(45, 106, 79, 0.55);
  }
  .pe-wa-float:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 28px rgba(37, 211, 102, 0.55);
    color: #fff;
  }
  @media (max-width: 768px) {
    .pe-wa-float {
      padding: 0.7rem;
      border-radius: 0;
    }
    .pe-wa-float__label { display: none; }
  }
</style>

<script>
  // Reveal the floating CTA once the visitor has scrolled past the hero.
  (function () {
    const el = document.getElementById('pe-wa-float');
    if (!el) return;
    const show = () => el.classList.toggle('is-visible', window.scrollY > window.innerHeight * 0.7);
    show();
    window.addEventListener('scroll', show, { passive: true });
    window.addEventListener('resize', show);
  })();
</script>
