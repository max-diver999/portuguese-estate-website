<div id="site-fx-note" class="site-fx-note" hidden>USD equivalents use the latest daily EUR rate. Original euro figures remain visible. <span id="site-fx-date"></span></div>
<style>
  .site-fx-note { position:fixed;left:50%;bottom:1rem;z-index:9999;width:max-content;max-width:min(34rem,calc(100vw - 2rem));padding:.7rem .95rem;transform:translateX(-50%);border-radius:10px;background:var(--color-ink);color:#e7e5e4;font-size:.78rem;line-height:1.45;box-shadow:0 8px 28px rgba(31,36,33,.28); }
  :global(.site-fx-value) { color:var(--color-muted);white-space:nowrap; }
</style>
<script>
  (function () {
    var RATE_KEY='portuguese-estate-fx-eur-usd-v1', PREF_KEY='portuguese-estate-show-usd', DAY=86400000, FALLBACK=1.17;
    var toggles=Array.prototype.slice.call(document.querySelectorAll('[data-site-fx-toggle]'));
    var root=document.querySelector('.prose')||document.querySelector('main');
    var note=document.getElementById('site-fx-note'), dateNode=document.getElementById('site-fx-date');
    if(!toggles.length||!root)return;
    var NUM='(\\d[\\d,]*(?:\\.\\d+)?)', SCALE_W='(\\s?(?:million|billion|M|K|k)\\b)?';
    var RE=new RegExp('(?:€\\s?|\\bEUR\\s?)'+NUM+SCALE_W+'(?:\\s*(?:to|\\u2013|-)\\s*(?:€\\s?|EUR\\s*)?'+NUM+SCALE_W+')?','g');
    var PROBE=new RegExp(RE.source), SCALE={million:1e6,billion:1e9,m:1e6,k:1e3}, wrapped=false, rate=FALLBACK, rateDate='';
    function amount(raw,word){var value=parseFloat(raw.replace(/,/g,''));if(!isFinite(value))return null;if(word)value*=SCALE[word.trim().toLowerCase()]||1;return value;}
    function usd(value){if(!isFinite(value)||value<=0)return null;if(value>=1e6)return '$'+(value/1e6).toFixed(value/1e6>=10?0:1).replace(/\.0$/,'')+'M';if(value>=1e5)return '$'+Math.round(value/1e3)+'K';return '$'+Math.round(value).toLocaleString('en-US');}
    function wrap(){
      if(wrapped)return;wrapped=true;
      var walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT,{acceptNode:function(node){var p=node.parentElement;if(!p||p.closest('script,style,code,pre,.site-fx-value'))return NodeFilter.FILTER_REJECT;return PROBE.test(node.nodeValue||'')?NodeFilter.FILTER_ACCEPT:NodeFilter.FILTER_REJECT;}});
      var targets=[],current;while((current=walker.nextNode()))targets.push(current);
      targets.forEach(function(node){var text=node.nodeValue||'',fragment=document.createDocumentFragment(),last=0,match;RE.lastIndex=0;
        while((match=RE.exec(text))){var low=amount(match[1],match[2]||(match[3]!=null?match[4]:null)),high=match[3]!=null?amount(match[3],match[4]||match[2]):null;if(low==null)continue;fragment.appendChild(document.createTextNode(text.slice(last,match.index+match[0].length)));var span=document.createElement('span');span.className='site-fx-value';span.dataset.low=String(low);if(high!=null)span.dataset.high=String(high);fragment.appendChild(span);last=match.index+match[0].length;}
        if(!last)return;fragment.appendChild(document.createTextNode(text.slice(last)));node.parentNode.replaceChild(fragment,node);
      });
    }
    function cached(){try{var value=JSON.parse(localStorage.getItem(RATE_KEY)||'null');return value&&isFinite(value.rate)&&Date.now()-value.savedAt<DAY?value:null;}catch(e){return null;}}
    async function load(){var value=cached();if(value)return value;var c=new AbortController(),timer=setTimeout(function(){c.abort();},3000);try{var response=await fetch('https://open.er-api.com/v6/latest/EUR',{signal:c.signal});if(!response.ok)throw 0;var data=await response.json(),next=Number(data&&data.rates&&data.rates.USD);if(!isFinite(next)||next<=0)throw 0;value={rate:next,savedAt:Date.now(),date:String(data.time_last_update_utc||'').slice(0,16)};try{localStorage.setItem(RATE_KEY,JSON.stringify(value));}catch(e){}return value;}catch(e){return{rate:FALLBACK,savedAt:Date.now(),date:'fallback rate'};}finally{clearTimeout(timer);}}
    function paint(on){if(on)wrap();root.querySelectorAll('.site-fx-value').forEach(function(span){if(!on){span.textContent='';return;}var low=usd(Number(span.dataset.low)*rate),high=span.dataset.high?usd(Number(span.dataset.high)*rate):null;span.textContent=low?' (~'+(high?low+' to '+high:low)+')':'';});toggles.forEach(function(t){t.setAttribute('aria-pressed',on?'true':'false');var l=t.querySelector('.site-fx-toggle__label');if(l)l.textContent=on?'USD shown':'Show USD';});if(dateNode)dateNode.textContent=rateDate?'Rate: '+rateDate+'.':'';if(note){note.hidden=!on;clearTimeout(note._timer);if(on)note._timer=setTimeout(function(){note.hidden=true;},6500);}}
    async function activate(){var latest=await load();rate=latest.rate;rateDate=latest.date;paint(true);}
    var on=false;try{on=localStorage.getItem(PREF_KEY)==='1';}catch(e){}if(on)activate();
    toggles.forEach(function(t){t.addEventListener('click',async function(){on=!on;try{localStorage.setItem(PREF_KEY,on?'1':'0');}catch(e){}if(on)await activate();else paint(false);});});
  })();
</script>
