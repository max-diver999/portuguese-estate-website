---
import { SITE } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer border-t-2 border-[var(--color-ink)] bg-[var(--color-deep)] text-[var(--color-slate)]">
  <div class="site-container py-12 grid gap-8 md:grid-cols-2 lg:grid-cols-4 text-sm">
    <div>
      <p class="text-lg font-bold text-[#f6f1e8] mb-2">{SITE.name}</p>
      <p class="leading-relaxed">{SITE.tagline}</p>
    </div>
    <div>
      <p class="footer-heading mb-3">Research</p>
      <ul class="space-y-2">
        <li><a href="/guides/" class="text-[var(--color-slate)] hover:text-[#f6f1e8] no-underline">Guides</a></li>
        <li><a href="/areas/" class="text-[var(--color-slate)] hover:text-[#f6f1e8] no-underline">Investment areas</a></li>
        <li><a href="/compare/" class="text-[var(--color-slate)] hover:text-[#f6f1e8] no-underline">Market comparisons</a></li>
        <li><a href="/segments/" class="text-[var(--color-slate)] hover:text-[#f6f1e8] no-underline">Buyer guides by nationality</a></li>
        <li><a href="/projects/" class="text-[var(--color-slate)] hover:text-[#f6f1e8] no-underline">Project reviews</a></li>
        <li><a href="/developers/" class="text-[var(--color-slate)] hover:text-[#f6f1e8] no-underline">Developer profiles</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-heading mb-3">Browse by budget</p>
      <ul class="space-y-2">
        <li><a href="/tier-entry/" class="text-[var(--color-slate)] hover:text-[#f6f1e8] no-underline">Under €200k</a></li>
        <li><a href="/tier-mid/" class="text-[var(--color-slate)] hover:text-[#f6f1e8] no-underline">€200k–€500k</a></li>
        <li><a href="/tier-luxury/" class="text-[var(--color-slate)] hover:text-[#f6f1e8] no-underline">Luxury €500k+</a></li>
        <li><a href="/portugal-property-consultation/" class="text-[var(--color-slate)] hover:text-[#f6f1e8] no-underline">Book a consultation</a></li>
        <li><a href="/get-shortlist/" class="text-[var(--color-slate)] hover:text-[#f6f1e8] no-underline">Free shortlist</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-heading mb-3">About</p>
      <ul class="space-y-2">
        <li><a href="/about/" class="text-[var(--color-slate)] hover:text-[#f6f1e8] no-underline">About us</a></li>
        <li><a href="/methodology/" class="text-[var(--color-slate)] hover:text-[#f6f1e8] no-underline">Methodology</a></li>
        <li><a href="/contact/" class="text-[var(--color-slate)] hover:text-[#f6f1e8] no-underline">Contact</a></li>
        <li><a href="/privacy-policy/" class="text-[var(--color-slate)] hover:text-[#f6f1e8] no-underline">Privacy</a></li>
        <li><a href="/terms/" class="text-[var(--color-slate)] hover:text-[#f6f1e8] no-underline">Terms</a></li>
        <li><a href={`mailto:${SITE.email}`} class="text-[var(--color-slate)] hover:text-[#f6f1e8] no-underline">{SITE.email}</a></li>
      </ul>
    </div>
  </div>
  <div class="site-container py-4 border-t border-[#f6f1e8]/15 text-xs text-[#9aa3b5]">
    © {year} {SITE.name}. Independent research — not financial or legal advice. Verify all figures with licensed professionals.
  </div>
</footer>

<style>
  .site-footer { margin-top: 4rem; }
  .footer-heading {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f6f1e8;
  }
</style>
