---
import { SITE } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="mt-16 border-t border-[var(--color-border)] bg-[var(--color-ink)] text-[#d6d3d1]">
  <div class="site-container py-12 grid gap-8 md:grid-cols-2 lg:grid-cols-4 text-sm">
    <div>
      <p class="text-lg font-semibold text-white mb-2">{SITE.name}</p>
      <p class="leading-relaxed">{SITE.tagline}</p>
    </div>
    <div>
      <p class="font-semibold text-white mb-3">Research</p>
      <ul class="space-y-2">
        <li><a href="/guides/" class="text-[#d6d3d1] hover:text-white no-underline">Guides</a></li>
        <li><a href="/areas/" class="text-[#d6d3d1] hover:text-white no-underline">Investment areas</a></li>
        <li><a href="/compare/" class="text-[#d6d3d1] hover:text-white no-underline">Market comparisons</a></li>
        <li><a href="/segments/" class="text-[#d6d3d1] hover:text-white no-underline">Buyer guides by nationality</a></li>
        <li><a href="/projects/" class="text-[#d6d3d1] hover:text-white no-underline">Project reviews</a></li>
        <li><a href="/developers/" class="text-[#d6d3d1] hover:text-white no-underline">Developer profiles</a></li>
      </ul>
    </div>
    <div>
      <p class="font-semibold text-white mb-3">Browse by budget</p>
      <ul class="space-y-2">
        <li><a href="/tier-entry/" class="text-[#d6d3d1] hover:text-white no-underline">Under €200k</a></li>
        <li><a href="/tier-mid/" class="text-[#d6d3d1] hover:text-white no-underline">€200k–€500k</a></li>
        <li><a href="/tier-luxury/" class="text-[#d6d3d1] hover:text-white no-underline">Luxury €500k+</a></li>
        <li><a href="/portugal-property-consultation/" class="text-[#d6d3d1] hover:text-white no-underline">Book a consultation</a></li>
        <li><a href="/get-shortlist/" class="text-[#d6d3d1] hover:text-white no-underline">Free shortlist</a></li>
      </ul>
    </div>
    <div>
      <p class="font-semibold text-white mb-3">About</p>
      <ul class="space-y-2">
        <li><a href="/about/" class="text-[#d6d3d1] hover:text-white no-underline">About us</a></li>
        <li><a href="/methodology/" class="text-[#d6d3d1] hover:text-white no-underline">Methodology</a></li>
        <li><a href="/contact/" class="text-[#d6d3d1] hover:text-white no-underline">Contact</a></li>
        <li><a href="/privacy-policy/" class="text-[#d6d3d1] hover:text-white no-underline">Privacy</a></li>
        <li><a href="/terms/" class="text-[#d6d3d1] hover:text-white no-underline">Terms</a></li>
        <li><a href={`mailto:${SITE.email}`} class="text-[#d6d3d1] hover:text-white no-underline">{SITE.email}</a></li>
      </ul>
    </div>
  </div>
  <div class="site-container py-4 border-t border-white/10 text-xs text-[#a8a29e]">
    © {year} {SITE.name}. Independent research — not financial or legal advice. Verify all figures with licensed professionals.
  </div>
</footer>
